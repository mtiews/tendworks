# Light palette of the diagrams: the brand colors (docs/brand/README.md) on white.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 32
    theme-overrides: {
      N1: "#1d2630"
      N2: "#4a5562"
      N7: "#ffffff"
    }
  }
  text: "#1d2630"
  muted: "#5b6672"
  line: "#7d8896"
  zone-fill: "#f3f6f8"
  zone-stroke: "#d5dce3"
  node-fill: "#ffffff"
  stem: "#2f6f4f"
  leaf: "#5fb38a"
  core-fill: "#e9f6ef"
  sandbox-fill: "#f7fcf9"
  harness-fill: "#d3eedf"
  store-fill: "#eaf2fb"
  store-stroke: "#3b6ea8"
  guard-fill: "#fdf4e2"
  guard-stroke: "#c98a1a"
}
