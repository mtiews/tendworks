# Dark palette of the diagrams: the web UI's tokens (apps/web/src/styles.css).
vars: {
  d2-config: {
    layout-engine: elk
    pad: 32
    theme-overrides: {
      N1: "#d7dee8"
      N2: "#aab4c0"
      N7: "#0b0e12"
    }
  }
  text: "#d7dee8"
  muted: "#9aa5b2"
  line: "#7d8896"
  zone-fill: "#12171e"
  zone-stroke: "#232b36"
  node-fill: "#171d26"
  stem: "#a8dcbf"
  leaf: "#5fb38a"
  core-fill: "#15251e"
  sandbox-fill: "#10181a"
  harness-fill: "#1d3a2d"
  store-fill: "#141d29"
  store-stroke: "#8cc4ff"
  guard-fill: "#221c10"
  guard-stroke: "#f5b942"
}
