# How a run flows through Tendworks. Colors come from palette-light.d2 or
# palette-dark.d2, which scripts/render-diagrams.sh puts in front of this file; it renders
# both SVGs next to it. Never edit the SVGs by hand.

vars: {
  d2-config: {
    layout-engine: dagre
  }
}

classes: {
  step: {
    style: {
      fill: ${core-fill}
      stroke: ${leaf}
      stroke-width: 2
      font-color: ${text}
      font-size: 22
      border-radius: 8
    }
  }
  sandbox: {
    style: {
      fill: ${harness-fill}
      stroke: ${stem}
      stroke-width: 2
      stroke-dash: 4
      font-color: ${text}
      font-size: 22
      border-radius: 8
    }
  }
  thing: {
    style: {
      fill: ${node-fill}
      stroke: ${line}
      font-color: ${text}
      font-size: 22
      border-radius: 8
    }
  }
  human: {
    style: {
      border-radius: 8
      stroke-width: 2
      fill: ${guard-fill}
      stroke: ${guard-stroke}
      font-color: ${text}
      font-size: 22
    }
  }
  flow: {
    style: {
      stroke: ${line}
      font-color: ${muted}
      font-size: 20
    }
  }
  ask: {
    style: {
      stroke: ${guard-stroke}
      font-color: ${muted}
      font-size: 20
      stroke-dash: 4
    }
  }
}

direction: right

trigger: "Trigger\nschedule · issue label · by hand" {class: thing}
workflow: "Workflow\ndurable, declarative" {class: step}
runtime: "Agent runtime" {class: step}
agent: "Agent in a sandbox\non its workspace" {class: sandbox}
artifact: "Artifact\ne.g. a pull request" {class: thing}
you: "You\nphone · web UI · tend" {class: human}

trigger -> workflow: starts {class: flow}
workflow -> runtime: A2A task {class: flow}
runtime -> agent: ACP {class: flow}
agent -> artifact: reports {class: flow}
artifact -> you: notification {class: flow}
workflow -> you: "policy says ask" {class: ask}
you -> workflow: decision {class: ask}
