{
  "name": "tendworks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "pnpm --filter @tendworks/shared generate",
    "build": "pnpm generate && tsc -b",
    "typecheck": "pnpm generate && tsc -b && tsc -p tsconfig.test.json",
    "lint": "depcruise packages apps tests && eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "docker compose -f deploy/compose.yaml --profile test-images build sandbox-scripted-acp && docker compose -f deploy/compose.yaml up -d --build --wait && vitest run --project e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "node scripts/install-git-hooks.mjs",
    "coverage": "vitest run --project unit --project integration --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
