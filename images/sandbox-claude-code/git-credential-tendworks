#!/bin/sh
# Generic git credential helper (any git host): answers `get` with the workspace credential
# the agent runtime passes in as TENDWORKS_GIT_USERNAME and TENDWORKS_GIT_PASSWORD, and
# with nothing when the session has none. The workspace's checkout configures it for the
# repository's host only (credential.<scheme>://<host>.helper), so the credential never
# goes to another host. Never stores or erases anything.
[ "$1" = get ] || exit 0
cat >/dev/null
[ -n "${TENDWORKS_GIT_PASSWORD:-}" ] || exit 0
printf 'username=%s\npassword=%s\n' "${TENDWORKS_GIT_USERNAME:-x-access-token}" "$TENDWORKS_GIT_PASSWORD"
