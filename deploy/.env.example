# Copy to deploy/.env and fill in. deploy/.env is never committed.

# Store password (defaults to "tend" for the laptop profile)
TEND_POSTGRES_PASSWORD=

# Harness credentials for agent profiles with harness claude-code.
# TEND_CLAUDE_CODE_CREDENTIAL selects which one goes into the sandbox: oauth-token
# (subscription token from `claude setup-token`; single-operator use only under
# Anthropic's terms) or api-key. Only the selected variable is used, never both.
TEND_CLAUDE_CODE_CREDENTIAL=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional alternative model endpoint, e.g. a gateway
ANTHROPIC_BASE_URL=

# Repository tokens for the playground repository
# agent token: goes into the sandbox; platform token: polling and merge, never in a sandbox
TENDWORKS_AGENT_GITHUB_TOKEN=
TENDWORKS_PLATFORM_GITHUB_TOKEN=
