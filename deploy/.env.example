# Copy to deploy/.env and fill in. deploy/.env is never committed.

# Store password (defaults to "tend" for the laptop profile)
TEND_POSTGRES_PASSWORD=

# API token: every operation but GET /status needs a bearer token, and operations that
# change state (start a run, merge, decide an approval request) need this one; the tend
# CLI and the smoke scripts read it from TEND_API_TOKEN too.
# Generate one with `openssl rand -hex 32`. Left empty, the laptop profile uses a
# well-known default, which is only acceptable while nothing but you can reach the
# published port on localhost.
TEND_API_TOKEN=
# Read-only token: accepted for reading only, refused (403) by operations that change
# state; for clients that should only read, e.g. the platform MCP server of chat agents.
# At least 16 characters and different from TEND_API_TOKEN (`openssl rand -hex 32`).
# Left empty, the laptop profile uses a well-known default (see above). It is never an
# agent secret: agent profiles cannot reference it.
TEND_API_READ_TOKEN=

# Harness credentials for agent profiles with harness claude-code.
# TEND_CLAUDE_CODE_CREDENTIAL selects which one goes into the sandbox: oauth-token
# (subscription token from `claude setup-token`; single-operator use only under
# Anthropic's terms) or api-key. Only the selected variable is used, never both.
TEND_CLAUDE_CODE_CREDENTIAL=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional alternative model endpoint, e.g. a gateway
ANTHROPIC_BASE_URL=

# Repository tokens for the playground repository
# agent token: goes into the sandbox; platform token: polling and merge, never in a sandbox
# (the developer agent profile passes the agent token in as GH_TOKEN through
#  `env: { GH_TOKEN: { secretRef: { name: TENDWORKS_AGENT_GITHUB_TOKEN } } }`; agent
#  profiles can only reference TENDWORKS_AGENT_* variables of the worker. Fine-grained,
#  playground repository only: contents and pull requests read/write.)
# (trigger bindings with `integration: github` reference it as
#  `github: { token: { secretRef: { name: TENDWORKS_PLATFORM_GITHUB_TOKEN } } }`; it needs
#  read access to issues, see ADR 0008 (secret-references-resolve-against-the-platform-environment);
#  the merge gate merges pull requests on github.com with it, which needs contents and
#  pull requests read/write)
TENDWORKS_AGENT_GITHUB_TOKEN=
TENDWORKS_PLATFORM_GITHUB_TOKEN=
