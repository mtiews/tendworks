{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "customConditions": [
      "source"
    ],
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "apps/web/vite.config.ts"
  ],
  "exclude": [
    "tests/web"
  ]
}
